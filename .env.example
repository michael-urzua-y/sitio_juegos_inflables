# Copia este archivo como .env y completa tus datos:  cp .env.example .env

# --- Seguridad (OBLIGATORIO en producción) ---
# Genera la clave con: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# Admin (dueño del negocio): se crea solo la primera vez; luego cambia la clave desde /admin/password
ADMIN_USER=admin
ADMIN_PASSWORD=
# Super admin (equipo de desarrollo): contenido de portada, textos, categorías y usuarios
SUPERADMIN_USER=superadmin
SUPERADMIN_PASSWORD=
# 1 cuando el sitio esté en HTTPS (cookies solo por HTTPS + HSTS)
COOKIE_SECURE=0
# 1 si estás detrás de un proxy (Nginx, Traefik, Cloudflare)
TRUST_PROXY=0

# --- Base de datos (docker-compose) ---
POSTGRES_USER=inflables
POSTGRES_PASSWORD=
POSTGRES_DB=inflables

# --- Sitio ---
# Los textos, WhatsApp, redes y contenido se editan desde /admin (no aquí)
SITIO_URL=http://localhost:8000
CREDITOS_URL=#
PORT=8000

# --- SEO: verificación de propiedad (opcional, la configura el desarrollador) ---
# Google Search Console > Configuración > Verificación > Etiqueta HTML: copia solo el valor de content="..."
GOOGLE_VERIFICACION=
BING_VERIFICACION=
FACEBOOK_VERIFICACION=
